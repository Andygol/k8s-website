    "hugo-extended": "^0.164.0",
    "netlify-cli": "^26.0.1",
    "postcss": "^8.5.19",
    "postcss-cli": "^11.0.1",
    "rtlcss": "^4.3.0"
  },
  "spelling": "cSpell:ignore docsy pkgs -"
